{
  "rules": {
    ".read": false,
    ".write": false,

    "freeFiles": {
      ".read": true,
      ".write": "auth != null && (auth.token.email === 'mrfaragphysics@gmail.com' || root.child('admins').child(auth.uid).val() === true)"
    },

    "files": {
      ".read": "auth != null && (auth.token.email === 'mrfaragphysics@gmail.com' || root.child('admins').child(auth.uid).val() === true || root.child('students').child(auth.uid).exists())",
      ".write": "auth != null && (auth.token.email === 'mrfaragphysics@gmail.com' || root.child('admins').child(auth.uid).val() === true)"
    },

    "students": {
      ".read": "auth != null && (auth.token.email === 'mrfaragphysics@gmail.com' || root.child('admins').child(auth.uid).val() === true)",
      ".write": "auth != null && (auth.token.email === 'mrfaragphysics@gmail.com' || root.child('admins').child(auth.uid).val() === true)",
      "$uid": { ".read": "auth != null && auth.uid === $uid" }
    },

    "joinRequests": {
      ".read": "auth != null && (auth.token.email === 'mrfaragphysics@gmail.com' || root.child('admins').child(auth.uid).val() === true)",
      ".write": "auth != null && (auth.token.email === 'mrfaragphysics@gmail.com' || root.child('admins').child(auth.uid).val() === true)",
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.child('status').val() === 'pending'"
      }
    },

    "admins": {
      "$uid": { ".read": "auth != null && auth.uid === $uid" }
    },

    "live_session": {
      ".read": "auth != null && (auth.token.email === 'mrfaragphysics@gmail.com' || root.child('admins').child(auth.uid).val() === true || root.child('students').child(auth.uid).exists())",
      "teacher": {
        ".write": "auth != null && (auth.token.email === 'mrfaragphysics@gmail.com' || root.child('admins').child(auth.uid).val() === true)"
      },
      "students": {
        "$uid": { ".write": "auth != null && auth.uid === $uid && root.child('students').child(auth.uid).exists()" }
      }
    }
  }
}
