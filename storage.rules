rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // الرفع والحذف للمدرس فقط، والقراءة تتم عبر روابط التحميل المحمية برمز سري
    match /materials/{allPaths=**} {
      allow read: if request.auth != null && request.auth.token.email == 'mrfaragphysics@gmail.com';
      allow write: if request.auth != null
                   && request.auth.token.email == 'mrfaragphysics@gmail.com'
                   && request.resource != null
                   && request.resource.size < 100 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.token.email == 'mrfaragphysics@gmail.com';
    }
  }
}
